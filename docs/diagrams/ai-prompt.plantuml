' Prompt class diagram
' With relevant classes and enums
' Created: 2025-10-02
' Last updated: 2025-10-14

@startuml ai-prompt

set separator /

abstract "Software/SoftwareArtifact" {
    + additionalPurpose : SoftwarePurpose [0..*]
    + artifactSize : xsd:nonNegativeInteger [0..1]
    + attributionText : xsd:string [0..*]
    + contentIdentifier : ContentIdentifier [0..*]
    + copyrightText : xsd:string [0..*]
    + primaryPurpose : SoftwarePurpose [0..*]
}

' Subclass Prompt from SoftwareArtifact as it represents a reasonable unit
' of content that can be attributed to a specific source.
' It is ligther than a DatasetPackage and requires less modification
' to the external properties restrictions.
class "AI/Prompt" extends "Software/SoftwareArtifact" {
    + /Software/contentIdentifier : /Software/ContentIdentifier [1..*]
    ---
    + /Core/inLanguage : /Core/LanguageTag [0..*]
    + /Core/contentModality : /Core/Modality [0..*]
    + /Software/contentType: /Core/MediaType [0..*]
    + /Dataset/dataCollectionProcess : xsd:string [0..1]
    + /Dataset/dataPreprocessing : xsd:string [0..1]
    + /Dataset/hasSensitivePersonalInformation : /Core/PresenceType [0..1]
    + isContextAugmented : xsd:boolean [0..1]
    + promptPattern : xsd:string [0..*]
}

enum "Core/Modality" {
    audio
    gesturePose
    hapticTactile
    image
    noAssertion
    other
    text
    video
}

@enduml
